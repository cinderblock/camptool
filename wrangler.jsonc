// CampTool on Cloudflare Workers + D1 + R2 (plans/hosting-other-camps.md).
// The Bun path (server.ts, Dockerfile) doesn't read this file.
//
//   bun run cf:dev       local, with a local D1 and R2 (no account needed)
//   bun run cf:deploy    build, apply D1 migrations, deploy
//
// No resource IDs here: `wrangler deploy` creates the D1 database and R2
// bucket on first deploy and remembers them, so a fork deploys as-is.
// Settings and secrets live on the Worker (dashboard → Settings → Variables
// and Secrets), not here, so one file serves every deployment
// (see docs/cloudflare-deploy.md):
//   PUBLIC_BASE_URL        variable, e.g. https://camptool.org (required)
//   CAMP_SUBDOMAINS        variable, "1" to give each camp <slug>.<domain>
//   LEGACY_HOSTS           variable, old hosts to redirect (moving a camp)
//   BETTER_AUTH_SECRET     secret (wrangler secret put)
//   DISCORD_*              optional secrets
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camptool",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-01",
  // node:crypto, node:zlib, node:stream, process.env.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run near the database rather than near each visitor: a page makes many
  // small queries, and each one is a round trip to D1.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camptool-db",
      // Prepared by `bun run cf:migrations` from db/migrations (D1 can't turn
      // foreign keys off; see scripts/d1-migrations.ts).
      "migrations_dir": ".d1-migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "camptool-files" }],
  // Per-visitor request limits (workers/rate-limit.ts). Cloudflare has no
  // spending cap, so these bound what one client can cost. Periods can only
  // be 10 or 60 seconds. Namespace IDs are account-wide counters: keep these
  // distinct from the other Workers on the account (1001, 1002, 2001 taken).
  "ratelimits": [
    // Not signed in, per IP.
    {
      "name": "RATE_LIMIT_ANON",
      "namespace_id": "4101",
      "simple": { "limit": 120, "period": 60 }
    },
    // Signed in, per session: a page and its data loads are several requests.
    {
      "name": "RATE_LIMIT_SIGNED_IN",
      "namespace_id": "4102",
      "simple": { "limit": 600, "period": 60 }
    },
    // Sign-in, sign-up and starting a camp, per IP, on top of the above.
    {
      "name": "RATE_LIMIT_AUTH",
      "namespace_id": "4103",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Deploys leave the Worker's variables alone. Without this, every deploy
  // would replace them with whatever `vars` this file has (none).
  "keep_vars": true
}
