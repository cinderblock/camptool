# --- Server ---
PORT=17923
# Public-facing base URL of this deployment. Used for auth callbacks and links.
PUBLIC_BASE_URL=http://localhost:17923

# --- Camp theme (Phase 2.5 customization seam) ---
# The camp-theme package whose customizations (custom map structures, etc.) this
# deployment uses. Defaults to the built-in @camptool/default-theme. Self-hosters
# point this at their own workspace package (e.g. @camptool/mathcamp-theme).
CAMP_THEME=@camptool/default-theme

# --- Database ---
# SQLite file. Parent dir is auto-created on startup. Mount the parent dir as a
# volume in production so state persists across restarts.
DATABASE_PATH=./data/camptool.db

# --- Uploaded pictures ---
# Where wiki/FAQ picture files are stored. Defaults to `uploads/` next to
# DATABASE_PATH, so the same persistent volume covers both. Originals are kept
# at full resolution, so size this for a camp's photo archive.
# NOTE: /export-db backs up the DATABASE ONLY — back this directory up too.
# UPLOADS_PATH=./data/uploads

# --- Auth (better-auth) ---
# A long random secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Dev telemetry API (optional) ---
# A secret token that unlocks the read-only telemetry endpoints for tracing:
#   GET /api/dev/errors?token=...    (client JS errors, with filters + ?group=1)
#   GET /api/dev/feedback?token=...  (user feedback submissions)
# Pass as ?token=... or "Authorization: Bearer ...". Leave UNSET to disable the
# endpoints entirely (they 404). Generate with: openssl rand -hex 24
DEV_API_TOKEN=

# --- Discord ---
# From https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The bot token (Bot tab) — used for sending DMs / reminders via REST.
DISCORD_BOT_TOKEN=
# The guild (server) ID all campers should belong to.
DISCORD_GUILD_ID=
