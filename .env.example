# --- Server ---
PORT=3000
# Public-facing base URL of this deployment. Used for auth callbacks and links.
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
# SQLite file. Parent dir is auto-created on startup. Mount the parent dir as a
# volume in production so state persists across restarts.
DATABASE_PATH=./data/camptool.db

# --- Auth (better-auth) ---
# A long random secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Discord ---
# From https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The bot token (Bot tab) — used for sending DMs / reminders via REST.
DISCORD_BOT_TOKEN=
# The guild (server) ID all campers should belong to.
DISCORD_GUILD_ID=
