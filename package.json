{
  "name": "camptool",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted Burning Man theme-camp registration & management.",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun --bun react-router dev",
    "build": "bun --bun react-router build",
    "start": "bun server.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^7.15.0",
    "@mantine/dates": "^7.15.0",
    "@mantine/form": "^7.15.0",
    "@mantine/hooks": "^7.15.0",
    "@mantine/notifications": "^7.15.0",
    "@react-router/node": "^7.13.0",
    "@react-router/serve": "^7.13.0",
    "better-auth": "^1.6.14",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@camptool/default-theme": "workspace:*",
    "@camptool/mathcamp-theme": "workspace:*",
    "@camptool/theme-contract": "workspace:*",
    "@react-router/dev": "^7.13.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.0"
  }
}
