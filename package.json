{
  "name": "camptool",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted Burning Man theme-camp registration & management.",
  "imports": {
    "#host/db": {
      "workerd": "./db/host/d1.ts",
      "default": "./db/host/bun-sqlite.ts"
    },
    "#host/blobs": {
      "workerd": "./app/host/blobs-r2.server.ts",
      "default": "./app/host/blobs-disk.server.ts"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --bun react-router dev",
    "build": "react-router build",
    "start": "bun server.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "bun test",
    "e2e:passkey": "node --experimental-strip-types e2e/passkey-signup.ts",
    "e2e:passkey-gate": "bun e2e/passkey-invite-gate.ts",
    "e2e:passkey-nag": "node --experimental-strip-types e2e/passkey-nag.ts",
    "e2e:password-reset": "bun e2e/password-reset.ts",
    "e2e:wiki": "bun e2e/wiki.ts",
    "e2e:faq": "bun e2e/faq.ts",
    "e2e:pictures": "bun e2e/pictures.ts",
    "e2e:backup": "bun e2e/backup.ts",
    "e2e:bins": "bun e2e/bins.ts",
    "e2e:bins-stock": "bun e2e/bins-stock.ts",
    "e2e:prospects": "bun e2e/prospects.ts",
    "e2e:responses": "bun e2e/question-responses.ts",
    "e2e:meetings": "node --experimental-strip-types e2e/meetings.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:verify": "bun scripts/verify-migrations.ts && bun scripts/d1-migrations.ts --check",
    "cf:migrations": "bun scripts/d1-migrations.ts",
    "cf:dev": "bun run cf:migrations && wrangler d1 migrations apply DB --local && CAMPTOOL_TARGET=cloudflare react-router dev",
    "cf:build": "bun run cf:migrations && CAMPTOOL_TARGET=cloudflare react-router build",
    "cf:preview": "bun run cf:build && wrangler d1 migrations apply DB --local && wrangler dev --config build/server/wrangler.json --port 17940",
    "cf:deploy": "bun run cf:build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "e2e:passkey-recovery": "node --experimental-strip-types e2e/passkey-recovery.ts",
    "e2e:member-merge": "bun e2e/member-merge.ts",
    "e2e:sap": "bun e2e/sap-passes.ts",
    "e2e:account": "bun e2e/account-and-wizard.ts",
    "e2e:passes-ui": "node --experimental-strip-types e2e/passes-ui.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.0.0",
    "@mantine/dates": "^9.0.0",
    "@mantine/form": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@mantine/notifications": "^9.0.0",
    "@react-router/node": "^8.0.0",
    "@react-router/serve": "^8.0.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "better-auth": "^1.7.15",
    "bwip-js": "^4.11.4",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.0",
    "unpdf": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@camptool/default-theme": "workspace:*",
    "@camptool/mathcamp-theme": "workspace:*",
    "@camptool/theme-contract": "workspace:*",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@react-router/dev": "^8.0.0",
    "@types/bun": "latest",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.162.0"
  }
}
